PROJECT_NAME=template # Debes reemplazar 'template' por el nombre de tu proyecto

MONGO_INITDB_ROOT_USERNAME=user_mongodb # Debes reemplazar 'user_mongodb' por un usuario dedicado para tu proyecto (recomendado)
MONGO_INITDB_ROOT_PASSWORD=password_root # Debes reemplazar 'password_root' por una generada con 'openssl rand -hex 32' (recomendado)